{
  "permissions": {
    "allow": [
      "Bash(claims/claims propose:*)",
      "Bash(claims/claims status:*)",
      "Bash(claims/claims renew:*)",
      "Bash(claims/claims export:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/claims/claims hook" }
        ]
      }
    ]
  }
}
